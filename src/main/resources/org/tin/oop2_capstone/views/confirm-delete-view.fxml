<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="popupRoot" style="-fx-background-color: rgba(0,0,0,0.5);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tin.oop2_capstone.controllers.DeleteConfirmationController">
    <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="200.0" prefWidth="350.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12;" styleClass="card">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <Label text="Confirm Deletion">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
        <Label fx:id="messageLabel" text="Are you sure you want to delete?" textAlignment="CENTER" wrapText="true" />
        <HBox alignment="CENTER" spacing="15.0">
            <Button mnemonicParsing="false" onAction="#onYesClick" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" text="Yes, Delete" />
            <Button mnemonicParsing="false" onAction="#onNoClick" style="-fx-background-color: #e5e7eb; -fx-text-fill: black; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-background-radius: 5;" text="No, Cancel" />
        </HBox>
    </VBox>
</StackPane>